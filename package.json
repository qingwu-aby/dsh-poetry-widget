{
  "name": "dsh-little-whale",
  "version": "0.1.4",
  "description": "DSH Web 界面里会自己长大的小鲸鱼：成长、记忆、自主生活，诗词与格律降权为二级菜单",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./assets/icon.webp",
  "files": [
    "index.js",
    "client.js",
    "assets",
    "data",
    "locale",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "lib",
    "PROVENANCE.md",
    "CHANGELOG.md",
    "client-src"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "poetry",
    "chinese-poetry",
    "widget",
    "feihua",
    "mood",
    "whale",
    "growth",
    "memory",
    "companion"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "opencc-js": "^1.4.2"
  },
  "author": "qingwu-aby",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingwu-aby/dsh-poetry-widget.git"
  },
  "homepage": "https://github.com/qingwu-aby/dsh-poetry-widget#readme",
  "bugs": {
    "url": "https://github.com/qingwu-aby/dsh-poetry-widget/issues"
  },
  "scripts": {
    "test": "npm run build:client && node --test tests/data.test.mjs tests/host.test.mjs tests/client/widget.test.mjs",
    "test:fast": "npm run build:client && node --test tests/data.test.mjs tests/host.test.mjs",
    "test:client": "npm run build:client && node --test tests/client/widget.test.mjs",
    "check": "npm run build:client && node --check index.js && node --check client.js && for f in lib/*.mjs; do node --check \"$f\" || exit 1; done",
    "build:client": "esbuild client-src/client.js --bundle --format=iife --platform=browser --outfile=client.js --log-level=warning",
    "smoke": "node scripts/live-smoke.mjs",
    "archive:memory": "node scripts/archive-memory.mjs",
    "archive:memory:dry": "node scripts/archive-memory.mjs -- --dry-run"
  }
}
