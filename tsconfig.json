{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "lib/kernel/**/*.mjs",
    "lib/composition/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "tests",
    "lib/legacy",
    "lib/domain",
    "lib/*.mjs"
  ]
}
