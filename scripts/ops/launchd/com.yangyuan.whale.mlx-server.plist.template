<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.yangyuan.whale.mlx-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__MLX_HOME__/server.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__MLX_HOME__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/dsh-whale-mlx/server.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/dsh-whale-mlx/server.err.log</string>
  <key>EnvironmentVariables</key>
  <dict><key>HOME</key><string>__HOME__</string></dict>
</dict>
</plist>
